<!-- Règles personnalisées RedOne - /var/ossec/etc/rules/local_rules.xml -->
<group name="local,syslog,sshd,">
  <!-- Exemple fourni par Wazuh (conservé) -->
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>
</group>

<group name="redone,syscheck,">
  <!-- Données stratégiques RedOne : aucune fuite ni altération tolérée -->
  <rule id="100100" level="12">
    <if_sid>550</if_sid>
    <field name="file">/srv/redone</field>
    <description>RedOne : donnée sensible MODIFIÉE ($(file))</description>
    <mitre><id>T1565.001</id></mitre>
    <group>redone_donnees,gdpr_II_5.1.f,</group>
  </rule>
  <rule id="100101" level="12">
    <if_sid>553</if_sid>
    <field name="file">/srv/redone</field>
    <description>RedOne : donnée sensible SUPPRIMÉE ($(file))</description>
    <mitre><id>T1485</id></mitre>
    <group>redone_donnees,gdpr_II_5.1.f,</group>
  </rule>
  <rule id="100102" level="10">
    <if_sid>554</if_sid>
    <field name="file">/srv/redone</field>
    <description>RedOne : nouveau fichier dans la zone de données sensibles ($(file))</description>
    <group>redone_donnees,gdpr_II_5.1.f,</group>
  </rule>
</group>

<group name="redone,windows,">
  <!-- Création d'un compte dans l'AD RedOne : toujours tracée en niveau élevé -->
  <rule id="100110" level="10">
    <if_sid>60109</if_sid>
    <description>RedOne : compte créé dans l'Active Directory ($(win.eventdata.targetUserName))</description>
    <mitre><id>T1136.002</id></mitre>
    <group>redone_ad,</group>
  </rule>
</group>

<!-- RedOne : routeur Cisco R-REDONE (journaux syslog, décodeur cisco-ios natif) -->
<group name="redone,cisco_ios,">

  <rule id="100120" level="12">
    <if_sid>4711</if_sid>
    <field name="cisco.facility">^SEC_LOGIN$</field>
    <field name="cisco.mnemonic">^QUIET_MODE_ON$</field>
    <description>RedOne : attaque par force brute sur le routeur R-REDONE, connexions bloquées (login block-for)</description>
    <mitre><id>T1110</id></mitre>
    <group>redone_routeur,authentication_failures,gdpr_IV_32.2,</group>
  </rule>

  <rule id="100121" level="3">
    <if_sid>4715</if_sid>
    <field name="cisco.facility">^SEC_LOGIN$</field>
    <field name="cisco.mnemonic">^QUIET_MODE_OFF$</field>
    <description>RedOne : fin du blocage des connexions sur le routeur R-REDONE</description>
    <group>redone_routeur,</group>
  </rule>

  <rule id="100122" level="8">
    <if_sid>4721</if_sid>
    <description>RedOne : configuration du routeur R-REDONE modifiée</description>
    <mitre><id>T1565</id></mitre>
    <group>redone_routeur,config_changed,</group>
  </rule>

</group>

<!-- RedOne : réseau Visiteurs du routeur R-REDONE (ACL VISITEURS-IN, journalisation « log ») -->
<group name="redone,cisco_ios,">

  <rule id="100123" level="7">
    <if_sid>4716</if_sid>
    <field name="cisco.facility">^SEC$|^FMANFP$</field>
    <field name="cisco.mnemonic">^IPACCESSLOGP$|^IPACCESSLOGDP$|^IPACCESSLOGNP$</field>
    <match>VISITEURS-IN</match>
    <description>RedOne : un poste du réseau Visiteurs a tenté d'accéder au réseau interne (bloqué par le routeur)</description>
    <mitre><id>T1046</id></mitre>
    <group>redone_routeur,redone_visiteurs,access_denied,</group>
  </rule>

  <rule id="100124" level="10" frequency="10" timeframe="60">
    <if_matched_sid>100123</if_matched_sid>
    <description>RedOne : nombreuses tentatives d'un visiteur vers le réseau interne (balayage probable)</description>
    <mitre><id>T1046</id></mitre>
    <group>redone_routeur,redone_visiteurs,</group>
  </rule>

</group>

<!-- RedOne : appareil non autorisé sur une prise Visiteurs du routeur (port-security) -->
<group name="redone,cisco_ios,">

  <rule id="100125" level="10">
    <if_sid>4712</if_sid>
    <field name="cisco.facility">^PORT_SECURITY$</field>
    <field name="cisco.mnemonic">^PSECURE_VIOLATION</field>
    <description>RedOne : appareil non autorisé branché sur une prise du routeur R-REDONE (bloqué par port-security)</description>
    <mitre><id>T1200</id></mitre>
    <group>redone_routeur,redone_visiteurs,</group>
  </rule>

</group>

#!/bin/bash
# Réponse active Wazuh RedOne : bloque l'adresse IP source d'une attaque dans nftables.
# Installée dans /var/ossec/active-response/bin/ sur chaque serveur Linux (agent Wazuh).
# L'adresse est ajoutée à l'ensemble « bloques » de la table inet wazuh_ar, avec un délai :
# nftables la retire tout seul au bout de 10 minutes (aucune règle à nettoyer).
# La table wazuh_ar est indépendante du pare-feu redone_fw : le recharger ne l'efface pas.
DUREE=10m
LOG=/var/ossec/logs/active-responses.log
NFT=/usr/sbin/nft
PROTEGES="127.0.0.1 192.168.100.141 192.168.100.2 192.168.100.209 10.2.1.51 10.2.1.1"  # poste admin, Proxmox, Wazuh, passerelle

read -r ENTREE
CMD=$(printf '%s' "$ENTREE" | grep -o '"command":"[a-z_]*"' | head -1 | cut -d'"' -f4)
IP=$(printf '%s' "$ENTREE" | grep -o '"srcip":"[0-9.]*"' | head -1 | cut -d'"' -f4)
REGLE=$(printf '%s' "$ENTREE" | grep -o '"rule":{[^}]*"id":"[0-9]*"' | grep -o '"id":"[0-9]*"' | cut -d'"' -f4)
journal() { echo "$(date '+%Y/%m/%d %H:%M:%S') redone-nft-drop: $*" >> "$LOG"; }

[ "$CMD" = "add" ] || exit 0
if ! [[ "$IP" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]]; then journal "pas d'adresse IP source dans l'alerte, rien à bloquer"; exit 0; fi
for P in $PROTEGES; do [ "$IP" = "$P" ] && { journal "$IP est protégée (administration), non bloquée"; exit 0; }; done

# Échange de clés avec wazuh-execd (protocole des réponses actives Wazuh 4.x)
printf '{"version":1,"origin":{"name":"redone-nft-drop","module":"active-response"},"command":"check_keys","parameters":{"keys":["%s"]}}\n' "$IP"
read -r -t 10 REPONSE || true
printf '%s' "$REPONSE" | grep -q '"command":"abort"' && { journal "$IP déjà traitée, abandon"; exit 0; }

$NFT list table inet wazuh_ar >/dev/null 2>&1 || $NFT -f - <<'EOF'
table inet wazuh_ar {
  set bloques {
    type ipv4_addr
    flags timeout
    comment "Adresses bloquées par la réponse active Wazuh"
  }
  chain input {
    type filter hook input priority filter - 10; policy accept;
    ip saddr @bloques counter drop comment "Réponse active Wazuh"
  }
}
EOF
if $NFT add element inet wazuh_ar bloques "{ $IP timeout $DUREE }" 2>>"$LOG"; then
  journal "$IP bloquée pour $DUREE (règle Wazuh $REGLE)"
  logger -t redone-nft-drop "Wazuh : $IP bloquée pour $DUREE (règle $REGLE)"
else
  journal "échec du blocage de $IP"
fi

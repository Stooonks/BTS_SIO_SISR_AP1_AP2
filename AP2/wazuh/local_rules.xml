<!-- Règles personnalisées RedOne - /var/ossec/etc/rules/local_rules.xml -->
<group name="local,syslog,sshd,">
  <!-- Exemple fourni par Wazuh (conservé) -->
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>
</group>

<group name="redone,syscheck,">
  <!-- Données stratégiques RedOne : aucune fuite ni altération tolérée -->
  <rule id="100100" level="12">
    <if_sid>550</if_sid>
    <field name="file">/srv/redone</field>
    <description>RedOne : donnée sensible MODIFIÉE ($(file))</description>
    <mitre><id>T1565.001</id></mitre>
    <group>redone_donnees,gdpr_II_5.1.f,</group>
  </rule>
  <rule id="100101" level="12">
    <if_sid>553</if_sid>
    <field name="file">/srv/redone</field>
    <description>RedOne : donnée sensible SUPPRIMÉE ($(file))</description>
    <mitre><id>T1485</id></mitre>
    <group>redone_donnees,gdpr_II_5.1.f,</group>
  </rule>
  <rule id="100102" level="10">
    <if_sid>554</if_sid>
    <field name="file">/srv/redone</field>
    <description>RedOne : nouveau fichier dans la zone de données sensibles ($(file))</description>
    <group>redone_donnees,gdpr_II_5.1.f,</group>
  </rule>
</group>

<group name="redone,windows,">
  <!-- Création d'un compte dans l'AD RedOne : toujours tracée en niveau élevé -->
  <rule id="100110" level="10">
    <if_sid>60109</if_sid>
    <description>RedOne : compte créé dans l'Active Directory ($(win.eventdata.targetUserName))</description>
    <mitre><id>T1136.002</id></mitre>
    <group>redone_ad,</group>
  </rule>
</group>

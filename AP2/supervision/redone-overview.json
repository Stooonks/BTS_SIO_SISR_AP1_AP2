{
  "uid": "redone-overview",
  "title": "RedOne – Vue d'ensemble supervision",
  "description": "Disponibilité, ressources et sécurité (ClamAV) des serveurs RedOne – AP2 BTS SIO SISR",
  "tags": ["redone", "ap2", "supervision"],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Serveur",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus-clamav" },
        "query": { "query": "label_values(node_uname_info, instance)", "refId": "v" },
        "definition": "label_values(node_uname_info, instance)",
        "includeAll": true,
        "multi": true,
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "refresh": 2
      }
    ]
  },
  "panels": [
    { "type": "row", "title": "Disponibilité", "id": 100, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "collapsed": false, "panels": [] },
    {
      "id": 1, "type": "stat", "title": "Cibles UP",
      "datasource": { "type": "prometheus", "uid": "prometheus-clamav" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "targets": [ { "refId": "A", "expr": "count(up == 1) or vector(0)", "instant": true } ],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "green" }, "unit": "none" }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value" }
    },
    {
      "id": 2, "type": "stat", "title": "Cibles DOWN",
      "datasource": { "type": "prometheus", "uid": "prometheus-clamav" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "targets": [ { "refId": "A", "expr": "count(up == 0) or vector(0)", "instant": true } ],
      "fieldConfig": { "defaults": { "unit": "none", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value" }
    },
    {
      "id": 3, "type": "stat", "title": "Alertes actives",
      "datasource": { "type": "prometheus", "uid": "prometheus-clamav" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "targets": [ { "refId": "A", "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)", "instant": true } ],
      "fieldConfig": { "defaults": { "unit": "none", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 3 } ] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value" }
    },
    {
      "id": 4, "type": "stat", "title": "Uptime",
      "datasource": { "type": "prometheus", "uid": "prometheus-clamav" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "targets": [ { "refId": "A", "expr": "time() - node_boot_time_seconds{instance=~\"$instance\"}", "instant": true, "legendFormat": "{{instance}}" } ],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 1, "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value" }
    },
    {
      "id": 5, "type": "stat", "title": "Antivirus ClamAV",
      "datasource": { "type": "prometheus", "uid": "prometheus-clamav" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "targets": [ { "refId": "A", "expr": "min(clamav_up)", "instant": true } ],
      "fieldConfig": {
        "defaults": {
          "mappings": [ { "type": "value", "options": { "0": { "text": "ARRÊTÉ", "color": "red" }, "1": { "text": "ACTIF", "color": "green" } } } ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        }, "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value" }
    },
    {
      "id": 6, "type": "stat", "title": "Âge des signatures ClamAV",
      "datasource": { "type": "prometheus", "uid": "prometheus-clamav" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "targets": [ { "refId": "A", "expr": "max(time() - clamav_db_updated_timestamp_seconds)", "instant": true } ],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 1, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 86400 }, { "color": "red", "value": 172800 } ] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value" }
    },

    { "type": "row", "title": "Ressources", "id": 101, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }, "collapsed": false, "panels": [] },
    {
      "id": 7, "type": "timeseries", "title": "Utilisation CPU",
      "datasource": { "type": "prometheus", "uid": "prometheus-clamav" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [ { "refId": "A", "expr": "100 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\",instance=~\"$instance\"}[5m])) * 100", "legendFormat": "{{instance}}" } ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "fillOpacity": 15, "lineWidth": 2, "thresholdsStyle": { "mode": "line+area" } }, "thresholds": { "mode": "absolute", "steps": [ { "color": "transparent", "value": null }, { "color": "red", "value": 90 } ] } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 8, "type": "timeseries", "title": "Utilisation mémoire",
      "datasource": { "type": "prometheus", "uid": "prometheus-clamav" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [ { "refId": "A", "expr": "(1 - node_memory_MemAvailable_bytes{instance=~\"$instance\"} / node_memory_MemTotal_bytes{instance=~\"$instance\"}) * 100", "legendFormat": "{{instance}}" } ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "fillOpacity": 15, "lineWidth": 2, "thresholdsStyle": { "mode": "line+area" } }, "thresholds": { "mode": "absolute", "steps": [ { "color": "transparent", "value": null }, { "color": "red", "value": 90 } ] } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 9, "type": "bargauge", "title": "Occupation des disques",
      "datasource": { "type": "prometheus", "uid": "prometheus-clamav" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [ { "refId": "A", "expr": "(1 - node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs|ramfs\",instance=~\"$instance\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay|squashfs|ramfs\",instance=~\"$instance\"}) * 100", "instant": true, "legendFormat": "{{instance}} {{mountpoint}}" } ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 75 }, { "color": "red", "value": 90 } ] } }, "overrides": [] },
      "options": { "orientation": "horizontal", "displayMode": "gradient", "reduceOptions": { "calcs": ["lastNotNull"] }, "showUnfilled": true }
    },
    {
      "id": 10, "type": "timeseries", "title": "Trafic réseau",
      "datasource": { "type": "prometheus", "uid": "prometheus-clamav" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [
        { "refId": "A", "expr": "rate(node_network_receive_bytes_total{device!~\"lo|veth.*|docker.*|br-.*\",instance=~\"$instance\"}[5m]) * 8", "legendFormat": "↓ {{instance}} {{device}}" },
        { "refId": "B", "expr": "-rate(node_network_transmit_bytes_total{device!~\"lo|veth.*|docker.*|br-.*\",instance=~\"$instance\"}[5m]) * 8", "legendFormat": "↑ {{instance}} {{device}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "bps", "custom": { "fillOpacity": 10, "lineWidth": 2 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },

    { "type": "row", "title": "État des cibles et alertes", "id": 102, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 }, "collapsed": false, "panels": [] },
    {
      "id": 11, "type": "table", "title": "Cibles supervisées",
      "datasource": { "type": "prometheus", "uid": "prometheus-clamav" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "targets": [ { "refId": "A", "expr": "up", "instant": true, "format": "table" } ],
      "transformations": [ { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true }, "renameByName": { "Value": "État", "job": "Job", "instance": "Cible", "host": "Hôte" } } } ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [ { "matcher": { "id": "byName", "options": "État" }, "properties": [
          { "id": "mappings", "value": [ { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } } ] },
          { "id": "custom.cellOptions", "value": { "type": "color-background" } } ] } ]
      },
      "options": { "showHeader": true }
    },
    {
      "id": 12, "type": "table", "title": "Alertes Prometheus en cours",
      "datasource": { "type": "prometheus", "uid": "prometheus-clamav" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "targets": [ { "refId": "A", "expr": "ALERTS", "instant": true, "format": "table" } ],
      "transformations": [ { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "Value": true }, "renameByName": { "alertname": "Alerte", "alertstate": "État", "severity": "Sévérité", "instance": "Cible" } } } ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "showHeader": true, "footer": { "show": false } }
    }
  ]
}
